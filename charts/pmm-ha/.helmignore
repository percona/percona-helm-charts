# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Dev-only harnesses for files/pmm-backup.sh (see the Makefile and the backup-script-tests CI
# job). They source the orchestrator as a library and stub the storage layer, so they are of no
# use to a chart consumer and ~49KB of shell in every release tarball.
tests/
