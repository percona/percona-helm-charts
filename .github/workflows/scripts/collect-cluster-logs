#!/usr/bin/env bash
set -uo pipefail

output_dir="${OUT:-cluster-logs}"
container_log_lines=500
disk_log_lines=2000

ps_log_files='/var/lib/mysql/log/*.log /var/lib/mysql/*.log /var/lib/mysql/*.err'
ps_config_files='/etc/my.cnf /etc/my.cnf.d/*.cnf /etc/mysql/config/auto-config.cnf /etc/mysql/config/my-config.cnf'
pxc_log_files='/var/lib/mysql/*.log /var/lib/mysql/*.err /var/lib/mysql/log/*.log /var/lib/mysql/.sst/*.log'
pxc_config_files='/etc/my.cnf /etc/mysql/node.cnf /etc/my.cnf.d/*.cnf /etc/percona-xtradb-cluster.conf.d/*.cnf'
pxc_state_files='/var/lib/mysql/grastate.dat /var/lib/mysql/gvwstate.dat'
psmdb_log_files='/data/db/logs/*'
pg_log_files='/pgdata/*/log/*.log /pgdata/*/pg_log/*.log'
pg_config_files='/pgdata/*/postgresql.conf /pgdata/*/postgresql.auto.conf'

capture() {
  local output=$1
  shift
  local status=0
  "$@" > "$output" 2>&1 || status=$?
  if (( status != 0 )); then
    printf 'Collection failed (exit %s); see %s\n' "$status" "$output" >&2
  fi
}

collect_container_files() {
  local namespace=$1 pod=$2 container=$3 destination=$4 database_container=${5:-}
  local files='' configs='' runtime=false

  case "$container" in
    mysql) files=$ps_log_files; configs=$ps_config_files; runtime=true ;;
    pxc) files="$pxc_log_files $pxc_state_files"; configs=$pxc_config_files; runtime=true ;;
    logs|logrotate)
      case "$database_container" in
        mysql) files=$ps_log_files ;;
        pxc) files="$pxc_log_files $pxc_state_files" ;;
        *) files=$psmdb_log_files ;;
      esac
      ;;
    mongod|mongos) files=$psmdb_log_files ;;
    database) files=$pg_log_files; configs=$pg_config_files ;;
    *) return ;;
  esac

  # File patterns are expanded inside the container, not on the runner.
  # shellcheck disable=SC2016
  capture "$destination" \
    kubectl exec "$pod" -n "$namespace" -c "$container" -- sh -c '
      status=0
      selected_options() {
        awk '"'"'
          /^[[:space:]]*(!include(dir)?[[:space:]]|\[[^]]+\])/ { print; next }
          {
            key = $0
            sub(/^[[:space:]]*/, "", key)
            sub(/^--/, "", key)
            sub(/[[:space:]=].*$/, "", key)
            gsub(/_/, "-", key)
            sub(/^loose-/, "", key)
            if (key ~ /^(no-defaults|defaults-file|defaults-extra-file|defaults-group-suffix|persisted-globals-load|wsrep-provider|wsrep-on|wsrep-cluster-address|wsrep-node-address|wsrep-node-name|wsrep-cluster-name|wsrep-sst-method|socket|port|bind-address|admin-address|admin-port|extra-port|datadir|basedir|plugin-dir|lc-messages-dir|log-error|log-error-verbosity|innodb-buffer-pool-size|innodb-buffer-pool-chunk-size|innodb-buffer-pool-instances|max-connections|gtid-mode|enforce-gtid-consistency|server-id|plugin-load|plugin-load-add|group-replication-group-seeds|group-replication-local-address|group-replication-start-on-boot|group-replication-bootstrap-group|group-replication-communication-stack|listen-addresses|unix-socket-directories|data-directory|logging-collector|log-directory|log-filename)$/)
              print
          }
        '"'"'
      }
      if [ "$4" = true ]; then
        printf "\n===== Runtime and resource diagnostics =====\n"
        date -u
        for file in /proc/meminfo /proc/pressure/* /proc/self/cgroup \
          /sys/fs/cgroup/memory.current /sys/fs/cgroup/memory.max \
          /sys/fs/cgroup/memory.peak /sys/fs/cgroup/memory.events \
          /sys/fs/cgroup/memory.stat /sys/fs/cgroup/memory.pressure \
          /sys/fs/cgroup/cpu.max /sys/fs/cgroup/cpu.stat \
          /sys/fs/cgroup/cpu.pressure /sys/fs/cgroup/io.stat \
          /sys/fs/cgroup/memory/memory.usage_in_bytes \
          /sys/fs/cgroup/memory/memory.limit_in_bytes \
          /sys/fs/cgroup/memory/memory.max_usage_in_bytes \
          /sys/fs/cgroup/memory/memory.failcnt \
          /sys/fs/cgroup/memory/memory.oom_control \
          /sys/fs/cgroup/cpu/cpu.stat; do
          [ -f "$file" ] || continue
          printf "\n===== %s =====\n" "$file"
          cat "$file" || status=1
        done
        df -h /var/lib/mysql || status=1
        df -i /var/lib/mysql || status=1
        for process in /proc/[0-9]*; do
          [ -r "$process/comm" ] || continue
          read -r name < "$process/comm" || continue
          case "$name" in mysqld|mysqld-debug|mysql-state-mon*) ;; *) continue ;; esac
          printf "\n===== %s executable and selected arguments (%s) =====\n" "$process" "$name"
          readlink "$process/exe" || status=1
          # Argument values may contain passwords; only allowlisted --key=value options are emitted.
          tr "\000" "\n" < "$process/cmdline" | selected_options || status=1
          for file in "$process/status" "$process/limits" "$process/io"; do
            [ -f "$file" ] || continue
            printf "\n===== %s (%s) =====\n" "$file" "$name"
            cat "$file" || status=1
          done
          printf "\n===== Configuration path permissions =====\n"
          for directory in /etc /etc/mysql /etc/mysql/config /etc/my.cnf.d \
            /etc/percona-xtradb-cluster.conf.d /usr/share/percona-server \
            /usr/share/percona-xtradb-cluster; do
            [ -d "$directory" ] || continue
            ls -ld "$directory" || status=1
          done
          printf "\n===== my_print_defaults (selected options only) =====\n"
          if command -v my_print_defaults >/dev/null 2>&1; then
            defaults="$(my_print_defaults mysqld server mysqld-8.4)" || status=1
            printf "%s\n" "$defaults" | selected_options
          else
            echo "my_print_defaults is not installed"
          fi
        done
        printf "\n===== TCP sockets =====\n"
        if command -v ss >/dev/null 2>&1; then
          ss -lnt || status=1
        else
          cat /proc/net/tcp /proc/net/tcp6 || status=1
        fi
        for file in /usr/share/percona-server/english/errmsg.sys \
          /usr/share/percona-xtradb-cluster/english/errmsg.sys \
          /usr/share/mysql/english/errmsg.sys; do
          [ -f "$file" ] || continue
          printf "\n===== %s =====\n" "$file"
          ls -l "$file" || status=1
          if [ -r "$file" ]; then echo readable; else echo not-readable; fi
        done
      fi
      for file in $1; do
        [ -f "$file" ] || continue
        printf "\n===== %s =====\n" "$file"
        tail -n "$3" "$file" || status=1
      done
      for file in $2; do
        [ -f "$file" ] || continue
        printf "\n===== %s (selected directives only) =====\n" "$file"
        ls -l "$file" || status=1
        selected_options < "$file" || status=1
      done
      exit "$status"
    ' sh "$files" "$configs" "$disk_log_lines" "$runtime"
}

collect_pod() {
  local namespace=$1
  local pod=$2
  local pod_dir="$output_dir/pods/$namespace/$pod"
  local pod_json database_container

  mkdir -p "$pod_dir"
  capture "$pod_dir/describe.txt" \
    kubectl describe pod "$pod" -n "$namespace"

  if ! pod_json="$(kubectl get pod "$pod" -n "$namespace" -o json)"; then
    printf 'Could not collect pod metadata: %s/%s\n' "$namespace" "$pod" >&2
    return 1
  fi
  database_container="$(jq -r '
    [.spec.containers[].name | select(. == "mysql" or . == "pxc")][0] // ""
  ' <<< "$pod_json")"

  while IFS= read -r container; do
    collect_container_files "$namespace" "$pod" "$container" \
      "$pod_dir/$container-files.txt" "$database_container"
  done < <(jq -r '.spec.containers[].name' <<< "$pod_json")

  while IFS=$'\t' read -r container restarts; do
    capture "$pod_dir/$container.log" \
      kubectl logs "$pod" -n "$namespace" -c "$container" \
        --timestamps --tail="$container_log_lines"
    if (( restarts > 0 )); then
      capture "$pod_dir/$container-previous.log" \
        kubectl logs "$pod" -n "$namespace" -c "$container" \
          --previous --timestamps --tail="$container_log_lines"
    fi
  done < <(jq -r '
    [.status.initContainerStatuses[]?, .status.containerStatuses[]?] |
    .[] | [.name, (.restartCount // 0)] | @tsv' <<< "$pod_json")

}

collect_cluster_overview() {
  local available_resources resource kind clusters

  capture "$output_dir/resources.txt" \
    kubectl get all,pvc,pv,storageclass -A -o wide
  capture "$output_dir/events.txt" \
    kubectl get events -A --sort-by=.lastTimestamp
  capture "$output_dir/nodes.txt" kubectl describe nodes

  if ! available_resources="$(kubectl api-resources --verbs=list -o name)"; then
    printf 'Could not discover cluster resource types\n' >&2
    return 1
  fi

  {
    for resource in psmdb ps pg pxc; do
      case "$resource" in
        psmdb) kind=perconaservermongodbs.psmdb.percona.com ;;
        ps) kind=perconaservermysqls.ps.percona.com ;;
        pg) kind=perconapgclusters.pgv2.percona.com ;;
        pxc) kind=perconaxtradbclusters.pxc.percona.com ;;
      esac
      grep -Fxq "$kind" <<< "$available_resources" || continue
      if ! clusters="$(kubectl get "$kind" -A -o json)"; then
        printf 'Could not list %s\n' "$kind" >&2
        continue
      fi
      jq -e '.items | length > 0' <<< "$clusters" >/dev/null || continue
      kubectl get "$resource" -A -o wide 2>&1 || true
      capture "$output_dir/cluster-$resource.yaml" \
        kubectl get "$resource" -A -o yaml
      capture "$output_dir/cluster-$resource-describe.txt" \
        kubectl describe "$resource" -A
    done
  } > "$output_dir/clusters.txt"
}

collect_pods() {
  while read -r namespace pod; do
    collect_pod "$namespace" "$pod"
  done < <(
    kubectl get pods -A --no-headers \
      -o custom-columns='NAMESPACE:.metadata.namespace,NAME:.metadata.name'
  )
}

collect_kind_logs() {
  [[ -n "${KIND_CLUSTER_NAME:-}" ]] || return
  capture "$output_dir/kind-export.txt" \
    kind export logs "$output_dir/kind" --name "$KIND_CLUSTER_NAME"
}

collect_host_resources() {
  [[ -n "${MINIKUBE_PROFILE:-}" ]] || return
  capture "$output_dir/host-resources.txt" bash -c '
    status=0
    uname -a
    for file in /proc/meminfo /proc/pressure/*; do
      [ -f "$file" ] || continue
      printf "\n===== %s =====\n" "$file"
      cat "$file" || status=1
    done
    docker version || status=1
    docker inspect "$1" --format \
      "MemoryLimit={{.HostConfig.Memory}} MemorySwap={{.HostConfig.MemorySwap}} NanoCPUs={{.HostConfig.NanoCpus}} OOMKilled={{.State.OOMKilled}}" || status=1
    docker stats --no-stream "$1" || status=1
    exit "$status"
  ' bash "$MINIKUBE_PROFILE"
}

main() {
  mkdir -p "$output_dir/pods"

  collect_cluster_overview
  collect_pods
  collect_kind_logs
  collect_host_resources

  echo "Diagnostics saved to $output_dir/"
}

main "$@"
